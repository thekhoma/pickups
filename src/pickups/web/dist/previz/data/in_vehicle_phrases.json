{
 "rule": "If a person and a vehicle (car, suv, truck, van, bus or any of their words) appear with 'in', 'inside', 'into', 'driving', 'drives', 'driver', 'behind the wheel', 'passenger', 'back seat', or a sit verb right before the vehicle ('sitting a car', missing 'in'), SEAT the person with seatInVehicle(person, vehicle, seat, pose) instead of placing them beside the vehicle. 'next to', 'beside', 'by', 'near', 'outside', 'leaning on', 'against', 'on the hood' and 'behind the <vehicle>' keep the person outside. 'driver' / 'driving' with no vehicle word adds a car. A child alone in a vehicle goes to the back seat. 'on the bus' seats a bus passenger.",
 "defaults": {
  "first person": "driver / drive",
  "second person": "passenger / sit_passenger",
  "third person": "rear_R / sit_passenger",
  "child alone": "rear_R / sit_passenger",
  "bus rider": "passenger (row0_R_win) or row<i>_<L|R>_<win|aisle>"
 },
